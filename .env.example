NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HUB mailbox (sales.afn.alpha). Does NOT auto-send campaigns — it is CC'd on
# every email and sends open/reply alerts + runs IMAP inbox scanning.
SALES_MAIL_FROM=sales.afn.alpha@gmail.com
SALES_MAIL_USER=sales.afn.alpha@gmail.com
SALES_MAIL_APP_PASSWORD=
# How recipients see your email (Gmail-suite style identity)
SALES_MAIL_FROM_NAME=Alpha Freight Network
SALES_MAIL_REPLY_TO=mikran.dispatch@gmail.com
# CC hub on every send (was kevin — now the AFN hub)
SALES_MAIL_CC=sales.afn.alpha@gmail.com

# The 10 Forces — each team sends its OWN automated email (Gmail App Password).
# A campaign with no team round-robins across whichever of these are configured.
SALES_MAIL_PATRIOT_APP_PASSWORD=
SALES_MAIL_LIBERTY_APP_PASSWORD=
SALES_MAIL_RANGER_APP_PASSWORD=
SALES_MAIL_EAGLE_APP_PASSWORD=
SALES_MAIL_HAWK_APP_PASSWORD=
SALES_MAIL_TITAN_APP_PASSWORD=
SALES_MAIL_FRONTIER_APP_PASSWORD=
SALES_MAIL_SENTINEL_APP_PASSWORD=
SALES_MAIL_VALOR_APP_PASSWORD=
SALES_MAIL_VANGUARD_APP_PASSWORD=
# Optional legacy Google OAuth (not required for sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Free tier: get a key at https://console.groq.com (recommended)
GROQ_API_KEY=
# Second Groq key — used automatically when primary hits rate limits
GROQ_API_KEY_2=
# Optional fallback — free quota is very limited
GEMINI_API_KEY=
# Primary production domain (Vercel custom domain). OAuth uses window.location.origin per deploy.
NEXT_PUBLIC_SITE_URL=https://freightsales.alphasolutions.software

# Google Voice account index (voice.google.com/u/N)
NEXT_PUBLIC_GOOGLE_VOICE_ACCOUNT=0
# PER-MAILBOX daily cap. This applies to EACH of the 10 Forces separately.
# Start at 10 per mailbox (10 teams = ~100/day total), raise as reputation builds.
# If unset, uses the warm-up schedule below, else defaults to 10.
DAILY_SEND_CAP=10
# Warm-up start date YYYY-MM-DD — ramps each mailbox 10→150/day. Leave unset to
# hold the flat DAILY_SEND_CAP while the new Gmail accounts build reputation.
SEND_WARMUP_START=
