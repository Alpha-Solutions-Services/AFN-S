NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared outbound mailbox (Gmail App Password — not per-user gmail.send OAuth)
SALES_MAIL_FROM=sales.afn.alpha@gmail.com
SALES_MAIL_USER=sales.afn.alpha@gmail.com
SALES_MAIL_APP_PASSWORD=
# How recipients see your email (Gmail-suite style identity)
SALES_MAIL_FROM_NAME=Alpha Freight Network
SALES_MAIL_REPLY_TO=mikran.dispatch@gmail.com
SALES_MAIL_CC=kevin.afn.dispatch@gmail.com
# Optional legacy Google OAuth (not required for sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Free tier: get a key at https://console.groq.com (recommended)
GROQ_API_KEY=
# Second Groq key — used automatically when primary hits rate limits
GROQ_API_KEY_2=
# Optional fallback — free quota is very limited
GEMINI_API_KEY=
# Primary production domain (Vercel custom domain). OAuth uses window.location.origin per deploy.
NEXT_PUBLIC_SITE_URL=https://freightsales.alphasolutions.software

# Google Voice account index (voice.google.com/u/N)
NEXT_PUBLIC_GOOGLE_VOICE_ACCOUNT=0
# Daily send limit (optional hard cap). If unset, uses warm-up schedule or default 20.
DAILY_SEND_CAP=
# Warm-up start date YYYY-MM-DD — ramps 10→150/day. Set this on first live send day.
SEND_WARMUP_START=2026-08-02
